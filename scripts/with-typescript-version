#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat << 'EOF'
Usage: with-typescript-version <version> -- <command> [args...]

Copies Git-tracked and non-ignored untracked files into a fresh .tmp workspace,
then installs dependencies, builds, installs the requested TypeScript version,
and runs the command there. Each invocation gets a fresh workspace. This is not
a security sandbox: absolute paths and symbolic links can still reach the
original.
EOF
}

if [[ $# -lt 3 || $2 != -- || -z $1 ]]; then
	usage >&2
	exit 2
fi

version=$1
shift 2

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
project_dir=$(cd -- "$script_dir/.." && pwd -P)
working_dir=$(pwd -P)

case "$working_dir" in
	"$project_dir") relative_dir=. ;;
	"$project_dir/"*) relative_dir=${working_dir#"$project_dir"/} ;;
	*)
		printf '%s\n' "Run this helper from inside its project directory ($project_dir)" >&2
		exit 1
		;;
esac
tmp_dir="$project_dir/.tmp/sandbox"
snapshot_dir=

if ! command -v pnpm > /dev/null 2>&1; then
	printf '%s\n' 'pnpm is required to install the temporary TypeScript version.' >&2
	exit 1
fi
if ! mkdir -p -- "$tmp_dir"; then
	printf '%s\n' "Could not create temporary directory $tmp_dir." >&2
	exit 1
fi
snapshot_dir=$(mktemp -d -- "$tmp_dir/$(date -u +%Y%m%dT%H%M%S)-$version-XXXXXXXX") || {
	printf '%s\n' "Could not create a snapshot directory under $tmp_dir." >&2
	exit 1
}

finish() {
	local status=$?
	trap - EXIT INT TERM HUP

	if [[ -n $snapshot_dir ]] && ! rm -rf -- "$snapshot_dir"; then
		printf '%s\n' "Could not remove snapshot directory $snapshot_dir." >&2
		status=$((status == 0 ? 1 : status))
	fi
	exit "$status"
}

trap finish EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

if ! git -C "$project_dir" ls-files --cached --others --exclude-standard -z -- \
	| while IFS= read -r -d '' path; do
		if [[ -e "$project_dir/$path" || -L "$project_dir/$path" ]]; then
			printf '%s\0' "$path"
		fi
	done \
	| tar --null --verbatim-files-from --no-recursion -C "$project_dir" --files-from=- -cf - \
	| tar -C "$snapshot_dir" -xf -; then
	printf '%s\n' "Could not copy the Git-selected project files into snapshot directory $snapshot_dir." >&2
	exit 1
fi

if ! pnpm --dir "$snapshot_dir" install --frozen-lockfile; then
	printf '%s\n' "Could not install the locked dependencies in snapshot directory $snapshot_dir." >&2
	exit 1
fi
if ! pnpm --dir "$snapshot_dir" build; then
	printf '%s\n' "Could not build the project in snapshot directory $snapshot_dir." >&2
	exit 1
fi
if ! pnpm --dir "$snapshot_dir" add --save-dev --save-exact --ignore-scripts "typescript@$version"; then
	printf '%s\n' "Could not install TypeScript version $version in the snapshot." >&2
	exit 1
fi

snapshot_working_dir=$snapshot_dir
if [[ $relative_dir != . ]]; then
	snapshot_working_dir="$snapshot_dir/$relative_dir"
fi
if ! mkdir -p -- "$snapshot_working_dir" || ! cd -- "$snapshot_working_dir"; then
	printf '%s\n' "Could not create or enter the copied working directory $snapshot_working_dir." >&2
	exit 1
fi

PATH="$snapshot_dir/node_modules/.bin:${PATH-}" "$@"
