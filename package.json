{
	"name": "tsc-after",
	"version": "0.4.0",
	"description": "Remove stale build output that tsc leaves behind when you delete or rename source files. Tsconfig-aware: just run tsc && tsc-after. 🧹",
	"keywords": [
		"build",
		"clean",
		"dist",
		"orphan",
		"outDir",
		"stale",
		"tsc",
		"typescript",
		"watch"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/michal-kocarek/tsc-after.git"
	},
	"license": "MIT",
	"author": {
		"name": "michal-kocarek"
	},
	"sideEffects": false,
	"type": "module",
	"exports": null,
	"bin": {
		"tsc-after": "bin/tsc-after.js"
	},
	"files": [
		"bin/",
		"dist/"
	],
	"scripts": {
		"build": "tsdown",
		"clean": "rm -rf .tmp dist coverage",
		"dev": "node src/entrypoints/tscAfter.ts",
		"format": "prettier --write .",
		"lint": "eslint . --max-warnings 0",
		"lint:knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
		"lint:spelling": "cspell --quiet --color .",
		"prepare": "husky",
		"release": "release-it",
		"test": "vitest",
		"test:e2e": "vitest --project e2e",
		"test:unit": "vitest --project unit",
		"typecheck": "tsc"
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"lint-staged": {
		"*": "prettier --ignore-unknown --write"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
		"@eslint/js": "10.0.1",
		"@eslint/markdown": "9.0.0",
		"@eslint/shell": "0.1.2",
		"@release-it/conventional-changelog": "12.0.2",
		"@tsconfig/node-lts": "26.0.1",
		"@tsconfig/node-ts": "23.6.5",
		"@tsconfig/strictest": "2.0.9",
		"@types/node": "26.6.6",
		"@vitest/coverage-v8": "5.1.1",
		"@vitest/eslint-plugin": "1.6.28",
		"console-fail-test": "0.10.0",
		"conventional-changelog-conventionalcommits": "10.4.1",
		"cspell": "10.5.2",
		"eslint": "10.15.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.18.1",
		"eslint-plugin-jsdoc": "65.5.0",
		"eslint-plugin-jsonc": "3.4.2",
		"eslint-plugin-n": "18.5.0",
		"eslint-plugin-package-json": "1.14.0",
		"eslint-plugin-perfectionist": "5.14.0",
		"eslint-plugin-regexp": "3.3.3",
		"eslint-plugin-yml": "3.10.0",
		"execa": "10.2.1",
		"husky": "9.1.7",
		"knip": "6.47.0",
		"lint-staged": "17.6.1",
		"prettier": "3.10.1",
		"prettier-plugin-curly": "0.4.2",
		"prettier-plugin-packagejson": "3.1.0",
		"prettier-plugin-sentences-per-line": "0.2.5",
		"prettier-plugin-sh": "0.20.2",
		"publint": "0.3.25",
		"release-it": "21.1.2",
		"tsdown": "0.23.7",
		"typescript": "6.0.3",
		"typescript-7": "npm:typescript@7.1.0-beta",
		"typescript-eslint": "8.73.0",
		"vitest": "5.1.1"
	},
	"peerDependencies": {
		"typescript": ">=3.9.10 <7 || >=7.1.0-beta <8"
	},
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": "^16.19.0 || >=18.11.0"
	}
}
