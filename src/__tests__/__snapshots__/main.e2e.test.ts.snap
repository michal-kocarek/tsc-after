// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`tsc-after > should print help 1`] = `
"tsc-after - Your dist, as tsc should've left it.

A tsconfig-aware companion to tsc. Removes stale build output by default.

USAGE
  tsc && tsc-after [options]

OPTIONS
  --project, -p <path>   Path to configuration file for this project, or to a folder with a 'tsconfig.json'.
  --dryRun               Do not delete any files.
  --verbose              Print verbose output.
  --version              Print version.
  --help, -h             Print this message."
`;
