// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`help > should print help 1`] = `
"tsc-after: Your outDir, as tsc should've left it.

COMMON COMMANDS

  tsc && tsc-after
  Removes stale outputs of the current project (tsconfig.json in the working directory).

  tsc-after -p ./path/to/tsconfig.json
  Removes stale outputs of the TypeScript project located at the specified path.

  tsc-after --copy src/schema.json:schema.json
  Removes stale outputs, then copies a file into 'outDir'.

  tsc-after --dry
  Shows what would be deleted from 'outDir', without deleting anything.

COMMAND LINE FLAGS

     --help, -h  Print this message.

      --version  Print the version.

  --project, -p  Use the project given the path to its configuration file, or to a directory with a 'tsconfig.json'.

      --noClean  Skip cleanup and only run '--copy'.

         --copy  Copy a file to a path relative to 'outDir', given as '<source>:<destination>'.

      --dry, -d  Preview removals and copies without changing files.

      --verbose  Enable verbose logging."
`;
