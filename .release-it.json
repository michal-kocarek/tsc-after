{
	"$schema": "https://raw.githubusercontent.com/release-it/release-it/refs/tags/21.1.0/schema/release-it.json",
	"git": {
		"commitMessage": "chore: release v${version}",
		"tagName": "v${version}"
	},
	"github": { "release": true },
	"hooks": { "after:bump": "pnpm build" },
	"npm": { "skipChecks": true, "stage": true },
	"plugins": {
		"@release-it/conventional-changelog": {
			"infile": "CHANGELOG.md",
			"preset": "conventionalcommits"
		}
	}
}
